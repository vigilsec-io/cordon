#!/usr/bin/env bash
# Valca pre-push gate.
#
# Install:  bash scripts/hooks/install.sh
#
# Why this exists: this repo publishes to public channels where a leak cannot be
# retracted, and the project's own thesis is that manual security checks get
# skipped. Every check below was, at some point, "remembered" instead of enforced —
# and one of them (the rule count) was wrong on two live listings for months.
#
# Blocks the push on:
#   1. PII / AI-attribution patterns in tracked files
#   2. Test failures, including the docs-vs-engine sync tests
#   3. Unscannable binary assets that are not in the reviewed allowlist
set -uo pipefail

REPO="$(git rev-parse --show-toplevel)"
cd "$REPO" || exit 1
FAIL=0

say() { printf '  %s\n' "$1"; }
echo "── Valca pre-push gate ───────────────────────────────"

# 1. PII gate. The checker lives in the private workspace; outside contributors
#    will not have it, so its absence is reported but not fatal for them.
PII_CHECK="../shared/vigil_publish_check.py"
if [ -f "$PII_CHECK" ]; then
  if python3 "$PII_CHECK" . >/tmp/valca-pii.$$ 2>&1; then
    say "✓ PII gate clean"
  else
    say "✗ PII GATE FAILED — push blocked"
    sed 's/^/    /' /tmp/valca-pii.$$
    FAIL=1
  fi
  rm -f /tmp/valca-pii.$$
else
  say "• PII checker not present (external clone) — skipped"
fi

# 2. Tests, including tests/test_docs_sync.py which asserts the README matches
#    the shipped engine. A release that misstates the product fails here.
PY="$(command -v python3)"
[ -x "../vigil/venv/bin/python" ] && PY="../vigil/venv/bin/python"
if "$PY" -m pytest tests/ -q >/tmp/valca-tests.$$ 2>&1; then
  say "✓ $(grep -oE '[0-9]+ passed' /tmp/valca-tests.$$ | tail -1)"
else
  say "✗ TESTS FAILED — push blocked"
  tail -15 /tmp/valca-tests.$$ | sed 's/^/    /'
  FAIL=1
fi
rm -f /tmp/valca-tests.$$

# 3. Binary assets cannot be scanned for PII by any automated tool, so each one
#    must be listed in .reviewed-assets after a manual frame-by-frame review.
ALLOWLIST=".reviewed-assets"
UNREVIEWED=""
while IFS= read -r asset; do
  [ -z "$asset" ] && continue
  if [ ! -f "$ALLOWLIST" ] || ! grep -qxF "$asset" "$ALLOWLIST"; then
    UNREVIEWED="$UNREVIEWED $asset"
  fi
done < <(git ls-files | grep -iE '\.(gif|png|jpg|jpeg|mp4|mov|webm|vsix|pdf)$')

if [ -n "$UNREVIEWED" ]; then
  say "✗ UNREVIEWED BINARY ASSETS — push blocked"
  for a in $UNREVIEWED; do say "    $a"; done
  say "    No scanner can read inside these. Review every frame for usernames,"
  say "    hostnames and workspace paths, then add the path to $ALLOWLIST."
  FAIL=1
else
  say "✓ all binary assets reviewed"
fi

echo "──────────────────────────────────────────────────────"
[ "$FAIL" -eq 0 ] || { echo "  PUSH BLOCKED. Fix the above, or --no-verify only if you are certain."; exit 1; }
echo "  All gates passed."
exit 0
